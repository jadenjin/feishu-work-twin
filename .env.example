# LarkAgentX 配置(全部有默认值,按需修改)
# 复制为 .env 放在项目根目录即可生效

# 区域: feishu(飞书国内版) | lark(Lark 国际版 larksuite.com)
# 只决定首次登录走哪边;登录后以凭证里记录的区域为准,切换用 lark auth qr --region <feishu|lark>
LARKX_REGION=feishu

# 数据目录(凭证/消息库/agent 会话)
LARKX_HOME=~/.larkx

# 消息存储: 留空 = SQLite(自动存到 LARKX_HOME/messages.db)
# 用 MySQL 则填: mysql+pymysql://<user>:<password>@<host>:3306/<db>
LARKX_STORAGE_URL=

# agent 上下文边界: anchor(会话+话题) | chat(会话); 旧 global 按 anchor 隔离
LARKX_CONTEXT_SCOPE=anchor

# agent 后端: claude | codex(ChatGPT账号登录) | compatible(HTTP接口) | none
LARKX_AGENT_BACKEND=codex

# Codex 后端: 先执行 codex login；模型留空使用 CLI 默认模型
LARKX_CODEX_MODEL=
LARKX_CODEX_TIMEOUT=180
LARKX_CODEX_REASONING_EFFORT=low
# 网页未设置时的消息停顿秒数(0.1-30)，默认最长等待 5 秒、合并 20 条
LARKX_BATCH_DELAY=1.5
LARKX_BATCH_MAX_WAIT=5
# 若 codex 不在 PATH 中，可指定可执行文件路径
LARKX_CODEX_PATH=

# 兼容 Chat Completions 的服务，需要支持 strict JSON Schema 才能用于工作台
# 仅选择 compatible 时使用；不会自动切换或发送数据给其他供应商
LARKX_AI_BASE_URL=
LARKX_AI_API_KEY=
LARKX_AI_MODEL=
LARKX_AI_TIMEOUT=180
# 服务和模型支持图片/缓存键时才开启；不支持时不会偷偷丢弃约束重试
LARKX_AI_IMAGES=false
LARKX_AI_CACHE_KEY=false
# 少数兼容服务只接受 max_tokens，按供应商文档修改
LARKX_AI_OUTPUT_TOKEN_FIELD=max_completion_tokens
# 通用文本输入估算预算、历史预算、HTTP 输出上限、历史有效期（秒）
# Codex 输出长度由 CLI/模型控制；数字不代表精确计费 token
LARKX_AI_INPUT_TOKEN_BUDGET=16000
LARKX_AI_HISTORY_TOKEN_BUDGET=6000
LARKX_AI_MAX_OUTPUT_TOKENS=2048
LARKX_AI_CONTEXT_TTL=86400

# 数字人系统提示词(留空用内置默认)
LARKX_SYSTEM_PROMPT=

# 收到消息自动标记已读(默认开;手机端未读角标会清掉)
LARKX_MARK_READ=false

# 触发前缀: 只处理以此前缀开头的消息(留空 = 全部处理)
# 例: LARKX_TRIGGER_PREFIX=/run
LARKX_TRIGGER_PREFIX=

# 登录凭证不放这里,用命令管理:
#   lark auth qr                            扫码登录(推荐)
#   lark auth import --cookie "<cookie>"    手动导入

# 群聊仅 @本人时自动回复
LARKX_TRIGGER_GROUP_AT_ONLY=true
